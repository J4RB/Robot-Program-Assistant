        "urscript": {
            "script": "global Point = struct(p=p[-0.28578544571908027, 0.09175824606152996, 0.53988094762566, 2.832463775200785, -1.8202090587229356, -1.519668430685042], frame=\"base\", q=[-0.6122081915484827, -2.162340303460592, 2.1631205717669886, -2.492721220056051, -2.033844296132223, 1.872475504875183])global Point_1 = struct(p=p[-0.4102119496366306, 0.196025160532814, 0.37646586444283336, 2.657293400750332, -1.960867027891352, -1.6073977955739192], frame=\"base\", q=[-0.6432426611529749, -1.5530838717571278, 2.217785183583395, -3.200853010217184, -2.039321247731344, 1.9577429294586182])global Point_2 = struct(p=p[-0.40918713026737696, 0.1953456476992318, 0.2793742926473415, 2.6463641916755503, -1.960205004722249, -1.62646395963512], frame=\"base\", q=[-0.6432111899005335, -1.3299042892507096, 2.322892967854635, -3.5411650143065394, -2.0416281859027308, 1.956700325012207])global Intermittent = struct(p=p[-0.2369322679328399, -0.09737804326246172, 0.44808151739746016, 2.8303438643499166, -0.9293751031276849, -1.5856380630674063], frame=\"base\", q=[0.0482884906232357, -2.278511186639303, 2.435761276875631, -2.634407182733053, -2.072821919118063, 2.0103752613067627])global Point_3 = struct(p=p[-0.2589747125632707, -0.33227652008495095, 0.3525207137619785, 2.369514114875934, 0.757088971880934, -1.2901058745766347], frame=\"base\", q=[0.5632306337356567, -1.6403314075865687, 2.3814085165606897, -3.3207365475096644, -1.4866903463946741, 1.569776177406311])global Point_4 = struct(p=p[-0.25893097998419906, -0.33224413926331164, 0.281377666768292, 2.3682759967534555, 0.7567839461153284, -1.2917967516028908], frame=\"base\", q=[0.5634101033210754, -1.4429541242173691, 2.4613097349749964, -3.5995193920531214, -1.488551441823141, 1.568984866142273])$ 1 \"tutorial\"$ 2 \"Modules\"$ 3 \"\"$ 4 \"Before Start\"$ 5 \"Configuration\"$ 6 \"Status\"$ 7 \"\"$ 8 \"\"set_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")optimovej(get_inverse_kin(convert_pose(Point.p, Point.frame, \"base\"), qnear=Point.q), a=0.09, v=0.3)$ 9 \"\"set_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")optimovej(get_inverse_kin(convert_pose(Point_1.p, Point_1.frame, \"base\"), qnear=Point_1.q), a=0.09, v=0.3)$ 10 \"3FG15 (2) - release | diameter: 110 mm | type: external\"tfg_release(diameter=110, tool_index=2)\\rtfg_payload_set(mass=0, tool_index=2)$ 11 \"\"set_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")optimovel(convert_pose(Point_2.p, Point_2.frame, \"base\"), a=0.09, v=0.3)$ 12 \"3FG15 (2) - grip | diameter: 40 mm | force: 80 % | weight: 1 kg | type: external\"tfg_flexible_grip(diameter=40, force=80, external_grip=True, stop_if_no_force=False, tool_index=2)\\rtfg_payload_set(mass=1, tool_index=2)$ 13 \"\"optimovel(convert_pose(Point_1.p, Point_1.frame, \"base\"), a=0.09, v=0.3)$ 14 \"\"set_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")optimovej(get_inverse_kin(convert_pose(Intermittent.p, Intermittent.frame, \"base\"), qnear=Intermittent.q), a=0.09, v=0.3)$ 15 \"\"set_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")optimovej(get_inverse_kin(convert_pose(Point_3.p, Point_3.frame, \"base\"), qnear=Point_3.q), a=0.09, v=0.3)$ 16 \"\"set_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")optimovel(convert_pose(Point_4.p, Point_4.frame, \"base\"), a=0.09, v=0.3)$ 17 \"3FG15 (2) - release | diameter: 110 mm | type: external\"tfg_release(diameter=110, tool_index=2)\\rtfg_payload_set(mass=0, tool_index=2)$ 18 \"\"optimovel(convert_pose(Point_3.p, Point_3.frame, \"base\"), a=0.09, v=0.3)$ 19 \"\"optimovej(get_inverse_kin(convert_pose(Intermittent.p, Intermittent.frame, \"base\"), qnear=Intermittent.q), a=0.09, v=0.3)$ 20 \"\"optimovej(get_inverse_kin(convert_pose(Point.p, Point.frame, \"base\"), qnear=Point.q), a=0.09, v=0.3)",
