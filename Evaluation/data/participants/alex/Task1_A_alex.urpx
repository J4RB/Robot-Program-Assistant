)\noptimovej(get_inverse_kin(convert_pose(Point_1.p, Point_1.frame, \"base\"), qnear=Point_1.q), a=0.09, v=0.5)\n$ 7 \"3FG15 (2) - Release | diameter: 110 mm | type: external\"\ntfg_release(diameter=110, tool_index=2)\r\ntfg_payload_set(mass=0, tool_index=2)\n$ 8 \"\"\nset_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")\noptimovej(get_inverse_kin(convert_pose(Point_2.p, Point_2.frame, \"base\"), qnear=Point_2.q), a=0.09, v=0.3, r=0.05)\n$ 9 \"\"\nset_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")\noptimovel(convert_pose(Point.p, Point.frame, \"base\"), a=0.09, v=0.3)\n$ 10 \"3FG15 (2) - Grip | diameter: 40 mm | force: 80 % | weight: 1 kg | type: external\"\ntfg_flexible_grip(diameter=40, force=80, external_grip=True, stop_if_no_force=False, tool_index=2)\r\ntfg_payload_set(mass=1, tool_index=2)\n$ 11 \"\"\noptimovel(convert_pose(Point_1.p, Point_1.frame, \"base\"), a=0.09, v=0.3)\n$ 12 \"\"\nset_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")\noptimovej(get_inverse_kin(convert_pose(Intermittent.p, Intermittent.frame, \"base\"), qnear=Intermittent.q), a=0.09, v=0.3)\n$ 13 \"\"\nset_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")\noptimovej(get_inverse_kin(convert_pose(Point_3.p, Point_3.frame, \"base\"), qnear=Point_3.q), a=0.09, v=0.3)\n$ 14 \"3FG15 (2) - Release | diameter: 110 mm | type: external\"\ntfg_release(diameter=110, tool_index=2)\r\ntfg_payload_set(mass=0, tool_index=2)\n$ 15 \"\"\nset_tcp(p[0, 0, 0, 0, 0, 0], \"Tool_flange\")\noptimovel(convert_pose(Point_4.p, Point_4.frame, \"base\"), a=0.09, v=0.3)\n$ 16 \"\"\noptimovej(get_inverse_kin(convert_pose(Point.p, Point.frame, \"base\"), qnear=Point.q), a=0.09, v=0.3)\n$ 17 \"\"\noptimovej(get_inverse_kin(convert_pose(Intermittent.p, Intermittent.frame, \"base\"), qnear=Intermittent.q), a=0.09, v=0.3)\n$ 18 \"\"\noptimovej(get_inverse_kin(convert_pose(Point_3.p, Point_3.frame, \"base\"), qnear=Point_3.q), a=0.09, v=0.3)\n$ 19 \"1.00 s\"\nsleep(1)","nodeIDList":["00000000-0000-0000-0000-000000000000","d6c026c6-9423-0f3d-85ef-63c546a